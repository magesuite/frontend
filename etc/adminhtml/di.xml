<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="creativeshopIcon" xsi:type="array">
                    <item name="class" xsi:type="string">MageSuite\Frontend\Form\Modifier\CreativeshopIcon</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\Widget\Model\Widget\Instance">
        <plugin
            name="encode_widget_content"
            type="MageSuite\Frontend\Plugin\Magento\Widget\Model\Widget\Instance\EncodeWidgetContent"
            sortOrder="1000"
        />
    </type>
    <type name="Magento\Widget\Block\Adminhtml\Widget\Options">
        <plugin
            name="decode_widget_options"
            type="MageSuite\Frontend\Plugin\Magento\Widget\Block\Adminhtml\Widget\Options\DecodeWidgetOptions"
            sortOrder="10"
        />
    </type>
</config>
